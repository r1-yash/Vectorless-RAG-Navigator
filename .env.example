# Environment Configuration for Vectorless RAG Lecture Navigator

# Groq API Key (Primary LLM provider)
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile

# Data Directory Storage & Database
DATA_DIR=data
DATABASE_PATH=data/navigator.db

# Throttling delay during batch tree ingestion (seconds between LLM calls)
BATCH_INGESTION_DELAY_SECONDS=0.5
MAX_RETRIES=4
